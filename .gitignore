# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config — client API keys are technically safe to expose (they are
# identifiers, not secrets; security lives in Firestore Rules), but we keep
# them out of the repo as hygiene. Regenerate anytime with: flutterfire configure
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase-debug.log
.firebase/

# Signing keys — NEVER commit these
*.jks
*.keystore
key.properties

# Emulator artifacts
firestore-debug.log
firebase-debug.log
ui-debug.log
test_rules/node_modules/
