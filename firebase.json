{
  "firestore": {
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "shuttlequeue-ph",
          "appId": "1:242522883046:android:911d624bbc6ddd0c934c27",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "shuttlequeue-ph",
          "configurations": {
            "android": "1:242522883046:android:911d624bbc6ddd0c934c27",
            "web": "1:242522883046:web:fbcd8e92d9a38b8d934c27"
          }
        }
      }
    }
  }
}
